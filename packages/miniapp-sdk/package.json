{
  "name": "@opt2-tealbrick/miniapp-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Teal Brick opt2 Miniapp SDK: server runtime (defineApp/startApp). Client, tb-exec and backups follow in 0.1.x.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.2/opt2-tealbrick-spec-0.1.2.tgz",
    "@opt2-tealbrick/manifest": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
