{
  "name": "opt2-tealbrick-__APP_ID__",
  "version": "0.1.0",
  "private": true,
  "description": "__APP_NAME__: a Teal Brick opt2 miniapp.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#kit": "./dist/kit/index.js"
  },
  "scripts": {
    "kit": "tb-gen kit && tsc -p gen/kit/__APP_ID__-kit --outDir dist/kit",
    "start": "node --run kit && node src/main.ts",
    "typecheck": "node --run kit && tsc --noEmit",
    "lint": "biome check .",
    "test": "node --run kit && node --test 'test/**/*.test.ts'",
    "conformance": "node --run kit && tb-conformance app --start conformance.start.ts --manifest tealbrick.manifest.json",
    "build": "node --run kit && tsc -p tsconfig.build.json && node scripts/build-ui.ts",
    "gen": "tb-gen all"
  },
  "dependencies": {
    "@opt2-tealbrick/manifest": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/manifest-v0.1.4/opt2-tealbrick-manifest-0.1.4.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/miniapp-sdk-v0.1.8/opt2-tealbrick-miniapp-sdk-0.1.8.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opt2-tealbrick/conformance": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/conformance-v0.1.5/opt2-tealbrick-conformance-0.1.5.tgz",
    "@opt2-tealbrick/ui": "https://github.com/Martin-Atrin/opt2-tealbrick-packages/releases/download/ui-v0.1.1/opt2-tealbrick-ui-0.1.1.tgz",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
